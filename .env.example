# Copie para .env na raiz. Configuração exclusiva de desenvolvimento local.
DJANGO_SECRET_KEY=local-demo-only-change-before-any-deployment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Assistente Gemini: chave somente no backend. O modelo pode ser substituído.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
